{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.master_room",
  "data": {
    "config": {
      "views": [
        {
          "theme": "ios-dark-mode-dark-green",
          "title": "Master Room",
          "path": "master-room",
          "subview": true,
          "badges": [],
          "cards": [
            {
              "square": true,
              "type": "grid",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "show_name": true,
                      "show_icon": true,
                      "type": "button",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/home"
                      },
                      "entity": "input_boolean.placeholder",
                      "icon": "mdi:keyboard-return",
                      "name": "Home",
                      "icon_height": "60px"
                    },
                    {
                      "show_name": true,
                      "show_icon": true,
                      "type": "button",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/master-room/master-room-tv"
                      },
                      "entity": "media_player.master_room_tv",
                      "icon": "mdi:remote-tv",
                      "name": "TV",
                      "icon_height": "50px"
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "entity": "climate.master_room",
                      "type": "custom:mushroom-climate-card",
                      "show_temperature_control": true,
                      "collapsible_controls": false,
                      "primary_info": "name",
                      "secondary_info": "state",
