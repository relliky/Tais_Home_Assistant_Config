                  }
                ]
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.master_room_unavailable_entities",
                  "state": "on"
                }
              ],
              "card": {
                "type": "custom:mushroom-title-card",
                "title": "Devices offline:",
                "subtitle": "{{ states.binary_sensor.master_room_unavailable_entities.attributes.value}} \n\nIt's likely due to running out of battery. Try to ask Tai to replace battery."
              }
            }
          ]
        },
