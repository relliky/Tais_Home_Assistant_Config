                "input_number.master_room_default_temperature",
                "switch.adaptive_lighting_sleep_mode_corridor",
                "switch.adaptive_lighting_sleep_mode_en_suite_room",
                "switch.adaptive_lighting_sleep_mode_en_suite_toilet",
                "switch.adaptive_lighting_sleep_mode_ground_toilet",
                "switch.adaptive_lighting_sleep_mode_guest_room",
                "switch.adaptive_lighting_sleep_mode_guest_toilet",
