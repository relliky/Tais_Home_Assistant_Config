                "switch.living_room_sonos_night_sound",
                "switch.living_room_sonos_speech_enhancement"
              ],
              "exclude": [],
              "title": false,
              "time_step": 30
            },
            {
              "type": "custom:auto-entities",
              "card": {
                "type": "entities",
