{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.living_room",
  "data": {
    "config": {
      "views": [
        {
          "theme": "ios-dark-mode-red",
          "title": "Living Room",
          "path": "living-room",
          "subview": true,
          "badges": [],
          "cards": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "show_name": true,
                      "show_icon": true,
                      "type": "button",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/lovelace/home"
                      },
                      "entity": "input_boolean.placeholder",
                      "icon": "mdi:keyboard-return",
                      "name": "Home",
                      "icon_height": "110px"
                    },
                    {
                      "type": "entities",
                      "entities": [
                        {
                          "entity": "input_select.living_room_scene",
                          "name": "Scene"
                        }
                      ],
                      "state_color": false
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "show_name": true,
                      "show_icon": true,
                      "type": "button",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "/living-room/living-room-tv"
                      },
                      "entity": "media_player.living_room_tv",
                      "icon": "mdi:remote-tv",
                      "name": "TV",
                      "icon_height": "110px",
                      "hold_action": {
                        "action": "navigate",
                        "navigation_path": "/living-room/living-room-tv"
                      }
                    },
                    {
                      "type": "custom:mushroom-climate-card",
                      "entity": "climate.living_room",
                      "hvac_modes": [
                        "auto"
                      ],
                      "show_temperature_control": true,
                      "collapsible_controls": false,
                      "primary_info": "name",
                      "secondary_info": "state",
                      "name": "Radiator"
                    }
                  ]
                }
              ],
              "columns": 2
            },
            {
              "square": false,
              "columns": 2,
              "type": "grid",
              "cards": [
                {
                  "type": "custom:mushroom-light-card",
                  "fill_container": true,
                  "use_light_color": true,
                  "show_brightness_control": true,
                  "show_color_control": true,
                  "show_color_temp_control": true,
                  "collapsible_controls": false,
                  "entity": "light.living_room_ceiling_light",
                  "icon": "mdi:chandelier",
                  "name": "Ceiling Light"
                },
                {
                  "type": "custom:mushroom-light-card",
                  "fill_container": false,
                  "use_light_color": true,
                  "show_brightness_control": true,
                  "show_color_control": false,
                  "show_color_temp_control": true,
                  "collapsible_controls": false,
                  "entity": "light.living_room_floor_light_1",
                  "name": "Floor Light 1",
                  "icon": "mdi:floor-lamp",
                  "double_tap_action": {
                    "action": "none"
                  }
                },
                {
                  "type": "custom:mushroom-light-card",
                  "fill_container": false,
                  "use_light_color": true,
                  "show_brightness_control": true,
                  "show_color_control": false,
                  "show_color_temp_control": true,
                  "collapsible_controls": false,
                  "entity": "light.living_room_floor_light_2",
                  "name": "Floor Light 2",
                  "icon": "mdi:lamps",
                  "double_tap_action": {
                    "action": "navigate",
                    "navigation_path": "living-room-3-head-lamp"
                  }
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "fill_container": true,
                  "entity": "switch.living_room_floor_light_3",
                  "name": "Floor Light 3",
                  "icon": "mdi:floor-lamp-dual",
                  "tap_action": {
                    "action": "toggle"
                  }
                },
                {
                  "features": [
                    {
                      "type": "cover-position"
                    }
                  ],
                  "type": "tile",
                  "name": "Left Curtain",
                  "entity": "cover.living_room_curtain_1",
                  "icon": "mdi:curtains-closed",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "cover.toggle",
                    "target": {
                      "entity_id": "cover.living_room_curtain_1"
                    },
                    "data": {}
                  },
                  "icon_tap_action": {
                    "action": "more-info"
                  },
                  "features_position": "bottom",
                  "vertical": false
                },
                {
                  "features": [
                    {
                      "type": "cover-position"
                    }
                  ],
                  "type": "tile",
                  "name": "Right Curtain",
                  "entity": "cover.living_room_curtain_2",
                  "icon": "mdi:curtains-closed",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "cover.toggle",
                    "target": {
                      "entity_id": "cover.living_room_curtain_2"
                    }
                  },
                  "features_position": "bottom",
                  "vertical": false,
                  "icon_tap_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:mushroom-light-card",
                  "fill_container": false,
                  "use_light_color": false,
                  "show_brightness_control": true,
                  "show_color_control": false,
                  "show_color_temp_control": true,
                  "collapsible_controls": false,
                  "entity": "light.boiler_room_light",
                  "icon": "mdi:ceiling-light"
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "fill_container": true,
                  "layout": "horizontal",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "entity": "switch.living_room_desk_screen_led",
                  "icon": "mdi:monitor",
                  "name": "Desk Screen LED"
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "fill_container": true,
                  "tap_action": {
                    "action": "toggle"
                  },
                  "entity": "input_boolean.living_room_heating_override",
                  "icon": "mdi:heating-coil",
                  "layout": "horizontal",
                  "name": "Heating Override",
                  "icon_color": "red"
                },
                {
                  "type": "tile",
                  "features_position": "bottom",
                  "vertical": false,
                  "entity": "binary_sensor.living_room_window",
                  "icon": "mdi:window-closed-variant",
                  "name": "window"
                },
                {
                  "type": "sensor",
                  "entity": "sensor.living_room_temperature_sensor",
                  "graph": "line",
                  "name": "Temperature"
                },
                {
                  "type": "custom:mushroom-lock-card",
                  "entity": "lock.garden_door_lock",
                  "name": "Garden Door"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.garden_door_handle_down",
                  "features_position": "bottom",
                  "vertical": false,
                  "icon": "mdi:door-closed-cancel",
                  "name": "Handle Down"
                },
                {
                  "type": "tile",
                  "entity": "binary_sensor.living_room_sliding_door",
                  "features_position": "bottom",
                  "vertical": false,
                  "icon": "mdi:door-sliding-open",
                  "name": "Sliding Door",
                  "show_entity_picture": false,
                  "hide_state": false
                },
                {
                  "type": "tile",
                  "entity": "sensor.garden_door_lock_battery",
                  "features_position": "bottom",
                  "vertical": false,
                  "name": "Lock Battery",
                  "icon": "mdi:battery-70"
                }
              ]
            },
            {
              "type": "custom:scheduler-card",
              "include": [
                "climate.living_room",
                "input_boolean.en_suite_room_sleep_time",
                "input_boolean.guest_room_sleep_time",
                "input_boolean.living_room_sleep_time",
                "input_boolean.master_room_sleep_time",
                "switch.adaptive_lighting_sleep_mode_living_room",
                "switch.living_room_sonos_night_sound",
                "switch.living_room_sonos_speech_enhancement"
              ],
              "exclude": [],
              "title": false,
              "time_step": 30
            },
            {
              "type": "custom:auto-entities",
              "card": {
                "type": "entities",
                "title": "Extra Controls"
              },
              "filter": {
                "include": [
                  {
                    "group": "group.living_room_occupancy_group"
                  },
                  {
                    "group": "group.living_room_auto_gen_automations"
                  }
                ]
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.living_room_unavailable_entities",
                  "state": "on"
                }
              ],
              "card": {
                "type": "custom:mushroom-title-card",
                "title": "Devices offline:",
                "subtitle": "{{ states.binary_sensor.living_room_unavailable_entities.attributes.value}} \n\nIt's likely due to running out of battery. Try to ask Tai to replace battery."
              }
            }
          ]
        },
        {
